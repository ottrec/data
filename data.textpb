facilities {
  name: "Champagne Fitness Centre"
  description:
    "The Champagne Fitness Centre is situated in a historic downtown building just a stone’s throw away from the "
    "ByWard Market. The facility houses a 22.86 metre (25 yards) four lane pool, weight and cardio rooms, sauna, and a "
    "mezzanine above the pool where the boxing programs are held. A large tile mural, Bathing in Champagne, is "
    "featured in the pool area."
  source {
    url: "https://ottawa.ca/en/recreation-and-parks/facilities/place-listing/champagne-fitness-centre"
    _date {
      seconds: 1778631698
    }
  }
  address:
    "321 King Edward Avenue\n"
    "Ottawa ON K1N 7M5\n"
    "Canada"
  _lnglat {
    lng: -75.68696
    lat: 45.4306
  }
  special_hours_html: "<p><strong>May 1 to August 31, </strong>closed.</p>"
  schedule_groups {
    label: "Drop-in schedule - swim"
    _title: "Swim"
    _noresv: true
  }
  schedule_groups {
    label: "Drop-in schedule - weight and cardio room"
    _title: "Weight And Cardio Room"
    _noresv: true
  }
}
facilities {
  name: "Chapman Mills Community Building"
  description:
    "The Chapman Mills Community Building is in the heart of this Barrhaven neighbourhood. The building features a "
    "bright half-moon shaped main hall, a small kitchenette and 14 parking spaces, making it a popular spot for "
    "private rentals. City recreation programs and camps are offered at this location. Water Dragon Park, which "
    "features a children's play structure, splash pad and gazebo, is adjacent to the building."
  source {
    url: "https://ottawa.ca/en/recreation-and-parks/facilities/place-listing/chapman-mills-community-building"
    _date {
      seconds: 1778631700
    }
  }
  address:
    "424 Chapman Mills Drive\n"
    "Ottawa ON K2J 0M7\n"
    "Canada"
  _lnglat {
    lng: -75.72315
    lat: 45.2721
  }
  special_hours_html:
    "<p>Please contact <a href=\"mailto:rideauview@ottawa.ca\">rideauview@ottawa.ca</a> for opening hours and washroom "
    "availability.</p>"
}
facilities {
  name: "Churchill Seniors Centre"
  description:
    "The centre offers a wide range of recreation programs for adults aged 50 and over. Programs include a variety of "
    "fitness classes you can register for, from Strength and Balance to yoga and even line dancing. Drop-in programs "
    "are available for those looking to play bridge or wanting to sing and play a ukulele. The facility has a "
    "programmed fitness centre, billiards equipment and a lounge."
  source {
    url: "https://ottawa.ca/en/recreation-and-parks/facilities/place-listing/churchill-seniors-centre"
    _date {
