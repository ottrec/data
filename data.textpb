facilities {
  name: "John G. Mlacak Centre"
  description:
    "John G Mlacak includes recreation program space, the Kanata Seniors Centre, arena and library. This is an ideal "
    "location to rent for meetings, gatherings or social events. The community exhibition space, currently programmed "
    "by the Kanata Civic Art Gallery and featuring work by its juried members, is located just inside the main "
    "entrance. New exhibitions are presented every few months."
  source {
    url: "https://ottawa.ca/en/recreation-and-parks/facilities/place-listing/john-g-mlacak-centre"
    _date {
      seconds: 1778631777
    }
  }
  address:
    "2500 Campeau Drive\n"
    "Ottawa ON K2K 2W3\n"
    "Canada"
  _lnglat {
