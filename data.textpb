    "</ul>\n"
    "<h3>Schedule change</h3>\n"
    "<ul>\n"
    "<li><strong>Saturday, May 23</strong>\n"
    "<ul>\n"
    "<li>Women&#39;s only public swim, 8:15 to 9:15 pm,<strong> added</strong></li>\n"
    "</ul>\n"
    "</li>\n"
    "</ul>\n"
