facilities {
  name: "Michele Heights Community Centre"
  description:
    "Michele Heights Community Centre's amenities include a divisible gymnasium with adjacent kitchen and a meeting "
    "room. With partner agencies we host a variety of programs aimed at improving the health of the community."
