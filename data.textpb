facilities {
  name: "Tanglewood Community Centre"
  description:
    "The Tanglewood Community Centre offers City recreation programs, summer camps and is available for private "
    "rentals."
  source {
    url: "https://ottawa.ca/en/recreation-and-parks/facilities/place-listing/tanglewood-community-centre"
    _date {
      seconds: 1778631883
    }
  }
  address:
    "30 Woodfield Drive\n"
    "Ottawa ON K2G 3Y5\n"
    "Canada"
  _lnglat {
    lng: -75.73042
    lat: 45.33662
  }
  special_hours_html: "<p>Please contact the facility by email for information on opening hours and washroom availability.</p>"
}
facilities {
  name: "Terry Fox Athletic Facility"
  description:
    "Track and field complex This outdoor sports facility features an extensive outdoor track and field complex "
    "featuring a lighted, international standard 400-metre polyurethane-surfaced eight-lane running track, along with "
    "multiple throwing and jumping event areas. These include high jump, long jump, javelin, shot put, hammer and "
    "discus. Sports fields The facility has three lit, premium-classed, grass sports fields, which can be used for a "
    "variety of activities such as soccer, lacrosse, ultimate Frisbee and special events. Mooneys Bay Ski Centre "
    "During the winter, the facility turns into a cross-country ski centre - Mooneys Bay Ski Centre - featuring "
    "five-kilometres of track-set lit trails, for classic and skate-skiing, and includes a ski school for all ages and "
    "abilities. See below for details."
  source {
    url: "https://ottawa.ca/en/recreation-and-parks/facilities/place-listing/terry-fox-athletic-facility"
    _date {
      seconds: 1778631884
    }
  }
  address:
    "2960 Riverside Drive\n"
    "Ottawa ON K1V 8N4\n"
    "Canada"
  _lnglat {
    lng: -75.69137
    lat: 45.36977
  }
  special_hours_html:
    "<ul>\n"
    "<li><span><strong>Monday, May 18</strong>, closed </span></li>\n"
    "</ul>\n"
    "<h3>Schedule changes</h3>\n"
    "<p>The facility is not available on the following dates due to special events:</p>\n"
    "<ul>\n"
    "<li><span><strong>April 23 to June 15, </strong></span>Monday to Friday, 8 am to 4 pm</li>\n"
    "<li><strong>May 3, </strong>9 am to 2 pm</li>\n"
    "<li><strong>May 9 and 10, </strong>9 am to 8 pm</li>\n"
    "<li><strong>May 31, </strong>9 am to 3 pm</li>\n"
    "<li><strong>June 16 to 21,</strong> 7 am to 11 pm</li>\n"
    "<li><strong>June 26,</strong> 2 pm to 9 pm</li>\n"
    "<li><strong>June 27</strong>, 9 am to 5 pm</li>\n"
    "<li><strong>September 5,</strong> 7 am to 4 pm</li>\n"
    "</ul>"
}
