  <span class="field field--name-title field--type-string field--label-hidden"><h2  class="h2">Visit the museum on a field trip</h2>
</span>





  
      <div class="field field--name-field-paragraphs field--type-entity-reference-revisions field--label-hidden field__items">
              <div class="field__item">  <div class="paragraph paragraph--type--fixed-layout paragraph--view-mode--default">
                  
                          
                                  
